# Sellora AI — Environment Variables (.env.local)

# 1. AI Model API (Optional for local engine, recommended for live cloud AI)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# 2. Supabase Cloud Auth & PostgreSQL Database (Optional for cloud scale)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Bangladesh Automated MFS Gateway — UddoktaPay (bKash, Nagad, Rocket)
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com/api/checkout-v2
NEXT_PUBLIC_APP_URL=http://localhost:3000
